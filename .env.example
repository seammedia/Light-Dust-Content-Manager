# Only client-side environment variables should use the VITE_ prefix.
# Copy this file to .env.local and fill in your actual values

# Server-side OpenAI key for captions, content ideas and automation.
# Do not prefix this with VITE_ or it will be exposed to browsers.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CAPTION_MODEL=gpt-5.6-luna

# Optional: retained for legacy Gemini image-generation scripts only.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Late API Key (for social media scheduling)
# Get your API key from https://getlate.dev/
VITE_LATE_API_KEY=your_late_api_key_here
